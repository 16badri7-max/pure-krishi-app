# Pure Krishi - Environment Variables Template
# Copy this file to .env and fill in your values
# NEVER commit .env to git

# ============================================================
# FRONTEND (Vite) — prefix all with VITE_
# ============================================================

# Supabase Project URL (from Supabase Dashboard > Project Settings > API)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anon/Public Key (safe to expose in browser)
VITE_SUPABASE_ANON_KEY=your_anon_key_here

# Backend API base URL (Railway deploy URL — no trailing slash)
VITE_API_URL=https://your-railway-service.up.railway.app

# ============================================================
# BACKEND (NestJS on Railway) — set in Railway dashboard
# ============================================================

# Supabase connection
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here  # From Supabase > Settings > API

# JWT signing secret — generate with: openssl rand -hex 32
JWT_SECRET=your_very_long_random_secret_here
JWT_EXPIRES_IN=7d

# Server
NODE_ENV=production
PORT=3001

# Optional: comma-separated extra CORS origins
CORS_ORIGINS=https://pure-krishi-app.vercel.app

# Optional: Railway provides this automatically for Postgres addon
DATABASE_URL=postgresql://user:pass@host:5432/db

# ============================================================
# AI SERVICE (FastAPI on Railway)
# ============================================================
GEMINI_API_KEY=your_gemini_api_key_here
