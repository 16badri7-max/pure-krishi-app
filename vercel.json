{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "app": {
      "root": ".",
      "framework": "vite",
      "buildCommand": "npm run build",
      "outputDirectory": "dist",
      "installCommand": "npm install"
    },
    "backend": {
      "root": "apps/backend",
      "framework": "nestjs",
      "buildCommand": "npm run build",
      "installCommand": "npm install",
      "bindings": [
        {
          "type": "service",
          "service": "ai-service",
          "format": "url",
          "env": "AI_SERVICE_URL"
        }
      ]
    },
    "ai-service": {
      "root": "apps/ai-service",
      "framework": "fastapi",
      "entrypoint": "main:app"
    },
    "web": {
      "root": "apps/web",
      "framework": "nextjs",
      "buildCommand": "npm run build",
      "installCommand": "npm install",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "NEXT_PUBLIC_API_URL"
        },
        {
          "type": "service",
          "service": "ai-service",
          "format": "url",
          "env": "NEXT_PUBLIC_AI_URL"
        }
      ]
    }
  },
  "rewrites": [
    {
      "source": "/api/ai/:path*",
      "destination": { "service": "ai-service" }
    },
    {
      "source": "/api/:path*",
      "destination": { "service": "backend" }
    },
    {
      "source": "/:path*",
      "destination": { "service": "app" }
    }
  ]
}
